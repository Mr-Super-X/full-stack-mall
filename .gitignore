# ---- 依赖与构建产物（各子项目另有局部 .gitignore，此处为根级兜底） ----
node_modules/
dist/
dist-ssr/
dist-prod/
coverage/
*.tsbuildinfo

# ---- OMC 代理编排本地状态（含会话/计划/日志，不入库） ----
.omc/

# ---- 本地私有配置（可能含密钥，禁止入库；frontend 已提交的 .env 均为非敏感配置） ----
*.local
.env.local
.env.*.local

# ---- 日志 ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 编辑器 / IDE ----
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ---- Claude Code 本地私有配置（共享配置仍入库） ----
.claude/settings.local.json
