# 路由部署基础路径：dev 不设（默认 /），由 dev:gateway 注入 /<app>/ 或 build-pages 注入 /<repo>/<app>/
# 控制全局应用中文名称
VITE_APP_TITLE=企业中后台管理
# 控制全局缓存命名空间
VITE_STORAGE_NAMESPACE=vue3-vite-project
# 控制 BEM 命名空间前缀（用于组件样式类名）
VITE_BEM_PREFIX=vv
# 控制路由历史模式（web | hash，用于子路径或静态托管部署）
VITE_HISTORY_MODE=web
# 控制业务品牌色（HEX，覆盖 Element Plus 默认蓝 `#409eff`，含灯色阶联动，详见 [docs/06-主题管理规范.md]
VITE_BRAND_COLOR=#409eff
# 控制路由菜单加载模式（local | remote）
VITE_MENU_SOURCE=remote
# 配置接口请求基础路径（必须以 `/` 开头，后端服务配置时请保持一致）


# 统一登录应用（apps/auth）origin/路径前缀（P4 跨应用登录协议）
VITE_AUTH_ORIGIN=/auth

# 演示模式：取消注释即开启，开启后无需登录即可访问应用
# VITE_DEMO_NO_AUTH=true
