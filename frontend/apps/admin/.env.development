# admin 开发环境变量 —— 只放**覆盖项**（公共默认见仓库根 .env / .env.development）。
#
# 联调真后端：VITE_USE_MOCK=false（工厂推导 VITE_API_BASE_URL=/api，经 dev:gateway 8080 同源代理 →
# admin:5174 → vite proxy → 18080，HttpOnly cookie path=/api 同源匹配，统一登录会话漫游）。
# mock 演示态删本行即继承根默认（VITE_USE_MOCK=true → /mock）。

# 统一登录应用（apps/auth）origin/路径前缀（P4 跨应用登录协议）
VITE_AUTH_ORIGIN=/auth

VITE_USE_MOCK=false

# 菜单来源改 local：/menu 是模板 mock 专属接口，后端无此端点——连真后端时 remote 探测
# 必然 404（全局包成 code:500 报「系统繁忙」）。local 用本地静态菜单（mall-admin 等业务路由
# 本就本地注册），不请求 /menu。后端提供 /mall/menu 后改回 remote（阶段 4+ 真 remote 菜单）。
VITE_MENU_SOURCE=local
